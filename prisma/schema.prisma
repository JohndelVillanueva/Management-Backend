// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserType {
  ADMIN
  HEAD
  STAFF
}

model Card {
  id               Int                @id @default(autoincrement())
  title            String
  description      String?
  status           String             @default("active")
  isPublic         Boolean            @default(false)
  viewCount        Int                @default(0)
  expiresAt        DateTime?
  allowedFileTypes String             @default("*")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  
  // Many-to-many relationship with departments
  departments      CardDepartment[]   // Relation to junction table
  submissions      Submission[]
  files            File[]
  headId           Int?
  head             User?              @relation(fields: [headId], references: [id])

  @@map("cards")
  @@index([status])
  @@index([expiresAt])
}

// Junction table for many-to-many relationship between Card and Department
model CardDepartment {
  id           Int        @id @default(autoincrement())
  cardId       Int
  departmentId Int
  card         Card       @relation(fields: [cardId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([cardId, departmentId])
  @@map("card_departments")
}

model VerificationToken {
  id         Int      @id @default(autoincrement())
  user_id    Int
  user       User     @relation(fields: [user_id], references: [id])
  token      String   @unique
  expires    DateTime
  createdAt  DateTime @default(now())

  @@map("verification_tokens")
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  expiresAt DateTime
  user_id   Int      @unique
  user      User     @relation(fields: [user_id], references: [id])

  @@map("password_reset_tokens")
}

model Activity {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  action      String
  resourceType String
  resourceId  Int
  description String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@map("activities")
  @@index([userId])
  @@index([action])
  @@index([resourceType])
  @@index([createdAt])
}

model User {
  id            Int       @id @default(autoincrement())
  username      String    @unique
  email         String    @unique
  password_hash String
  user_type     UserType  @default(STAFF)
  departmentId  Int?
  department    Department? @relation(fields: [departmentId], references: [id])
  first_name    String?
  last_name     String?
  phone_number  String?
  avatar        String?
  bio           String?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  last_login    DateTime?
  is_verified   Boolean   @default(false)
  is_active     Boolean   @default(true)
  passwordResetToken PasswordResetToken?
  verificationTokens VerificationToken[]
  submissions Submission[]
  files File[]
  activities Activity[]
  cards Card[]  // Cards where this user is the head

  @@map("users")
  @@index([user_type])
  @@index([is_active])
  @@index([departmentId])
}

model Department {
  id           Int               @id @default(autoincrement())
  name         String
  code         String            @unique
  description  String?
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  submissions  Submission[]
  cardDepartments CardDepartment[]  // Relation to junction table
  users        User[]

  @@map("departments")
}

model Submission {
  id           Int        @id @default(autoincrement())
  title        String
  description  String?
  type         String
  link         String
  status       String     @default("active")
  isPublic     Boolean    @default(false)
  viewCount    Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  userId       Int
  cardId       Int
  departmentId Int?
  user         User       @relation(fields: [userId], references: [id])
  card         Card       @relation(fields: [cardId], references: [id])
  department   Department? @relation(fields: [departmentId], references: [id])

  @@map("submissions")
  @@index([cardId])
  @@index([userId])
  @@index([departmentId])
  @@index([status])
}

model File {
  id          Int      @id @default(autoincrement())
  name        String
  originalName String
  type        String
  mimeType    String?
  size        Int?
  path        String
  extension   String?
  isPublic    Boolean  @default(false)
  downloadCount Int    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  cardId      Int
  card        Card     @relation(fields: [cardId], references: [id])
  userId      Int
  user        User     @relation(fields: [userId], references: [id])

  @@map("files")
  @@index([cardId])
  @@index([userId])
}